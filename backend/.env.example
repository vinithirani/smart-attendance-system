# Smart Attendance System - Backend Configuration
PROJECT_NAME="Smart Attendance System Using Face Recognition"
API_V1_STR="/api/v1"
SECRET_KEY="super_secret_jwt_key_change_in_production_for_academic_project"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/smart_attendance_db
# Leave blank or use sqlite:///./smart_attendance.db for zero-config local demo mode
DATABASE_URL=sqlite:///./smart_attendance.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Face Recognition Settings
FACE_SIMILARITY_THRESHOLD=0.65
UNKNOWN_PERSON_THRESHOLD=0.55
